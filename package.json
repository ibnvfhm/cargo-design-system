{
  "name": "cargo-design-system",
  "private": true,
  "description": "Cargo Design System: design tokens dan komponen untuk semua produk Cargo.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "docs": "npm run dev -w @cargo/docs",
    "docs:build": "npm run build -w @cargo/docs"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
