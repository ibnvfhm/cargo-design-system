---
import { COMPONENT_TABS } from '../lib/components.mjs';
import { SECTIONS, SIDEBAR, url } from '../lib/site.mjs';
import { BRANDS } from '../lib/tokens.mjs';

interface Props {
  section: string;
  /** Normalised path of the current page, with a trailing slash. */
  path: string;
}

const { section, path } = Astro.props;
const groups = SIDEBAR[section];
const sectionLabel = SECTIONS.find((item) => item.id === section)?.label;

// A page two levels deep, such as /komponen/button/, also holds its tabs below it.
const holds = (href) => href !== path && href.split('/').filter(Boolean).length >= 2 && path.startsWith(href);
// The open component lists its other tabs under its name, as Soul does.
const tabsOf = (href) =>
  section === 'komponen' && href !== '/komponen/' && (href === path || holds(href))
    ? COMPONENT_TABS.filter((tab) => tab.path).map((tab) => ({ label: tab.label, href: `${href}${tab.path}` }))
    : [];
---

<aside class="sidebar" id="sidebar" data-sidebar>
  <div class="sidebar-mobile">
    <nav class="sections" aria-label="Bagian">
      {SECTIONS.map((item) => <a href={url(item.href)} aria-current={item.id === section ? 'true' : undefined}>{item.label}</a>)}
    </nav>
    <label>
      Brand
      <select data-brand-select>
        {BRANDS.map((brand) => <option value={brand.id}>{brand.name}</option>)}
      </select>
    </label>
  </div>
  <nav aria-label={`Halaman ${sectionLabel}`}>
    {
      groups.map((group) => (
        <div class="side-group">
          {group.title && <p class="side-title">{group.title}</p>}
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={url(item.href)} aria-current={item.href === path ? 'page' : undefined} data-within={holds(item.href) ? '' : undefined}>
                  {item.label}
                </a>
                {tabsOf(item.href).length > 0 && (
                  <ul class="side-sub">
                    {tabsOf(item.href).map((tab) => (
                      <li>
                        <a href={url(tab.href)} aria-current={tab.href === path ? 'page' : undefined}>
                          {tab.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
</aside>
<div class="sidebar-backdrop" hidden data-sidebar-backdrop></div>
