---
import { Code } from 'astro:components';
import Icon from './Icon.astro';

interface Props {
  code: string;
  lang?: string;
  title?: string;
}

const { code, lang = 'plaintext', title } = Astro.props;
---

<div class="code-block">
  <div class="code-block-head">
    <span>{title ?? lang.toUpperCase()}</span>
    <button class="copy-btn" type="button" data-copy={code.trim()}>
      <Icon name="Copy" size={16} /><span data-copy-label>Salin</span>
    </button>
  </div>
  <Code code={code.trim()} lang={lang} themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
</div>
