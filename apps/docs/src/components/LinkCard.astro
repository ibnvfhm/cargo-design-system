---
import Icon from './Icon.astro';

interface Props {
  href: string;
  title: string;
  text?: string;
  icon?: string;
  external?: boolean;
}

const { href, title, text, icon, external = false } = Astro.props;
---

<a class="link-card" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
  {icon && <span class="link-card-icon"><Icon name={icon} size={22} /></span>}
  <p class="link-card-title">{title}</p>
  {text && <p class="link-card-text">{text}</p>}
  <slot />
  <Icon class="link-card-arrow" name={external ? 'ArrowUpRight' : 'ArrowRight'} size={18} />
</a>
