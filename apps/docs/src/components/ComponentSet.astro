---
import { PREVIEW_SCALE, PROPERTY_TYPES } from '../lib/components.mjs';
import { renderMarkdown } from '../lib/markdown.mjs';

interface Props {
  set: any;
  /** "usage" for the preview and guidance, "design" for variants and properties, "all" for both. */
  part?: 'usage' | 'design' | 'all';
  /** Heading level for "Kapan dipakai", "Varian", and the other parts of the description. */
  level?: 2 | 3 | 4;
  /** Prefix for heading ids, so the page outline can link to them. Without it, headings get no id. */
  idPrefix?: string;
  /** Puts a "Pratinjau" heading above the preview. */
  previewHeading?: boolean;
}

const { set, part = 'all', level = 3, idPrefix, previewHeading = false } = Astro.props;
const Heading = `h${level}`;
const usage = part !== 'design';
const design = part !== 'usage';
const id = (name) => (idPrefix === undefined ? undefined : `${idPrefix}${name}`);

// The first paragraph is the summary, shown above; the rest holds "Kapan dipakai", "Cara pakai", and "Hindari".
const body = set.md.split(/\n\s*\n/).slice(1).join('\n\n');
const axes = Object.entries(set.axes ?? {});

// "Icon-User (Type=Regular, Size=18)" → name "Icon-User", detail "Regular, 18".
const swapDefault = (value) => {
  const match = String(value).match(/^(.*?)\s*\((.*)\)$/);
  if (!match) return { name: value, detail: '' };
  return { name: match[1], detail: match[2].split(',').map((part) => part.split('=').pop().trim()).join(', ') };
};

// One row of images per Size or State axis, like the Sizes and States sections in Soul.
const SHOT_TITLES = { Size: { title: 'Ukuran', id: 'ukuran', note: 'dari yang terkecil' }, State: { title: 'State', id: 'state', note: '' } };
const shots = (set.shots ?? []).map((shot) => ({
  ...shot,
  ...SHOT_TITLES[shot.axis],
  // Columns may shrink to 85% of the widest image before the row wraps.
  width: Math.max(...shot.items.map((item) => item.light.width / PREVIEW_SCALE)),
  others: Object.entries(shot.fixed).map(([key, value]) => `${key} ${value}`),
}));
---

{usage && set.preview.light && previewHeading && <Heading class="spec-title" id={id('pratinjau')}>Pratinjau</Heading>}

{
  usage && set.preview.light && (
    <figure class="preview">
      <div class="preview-stage">
        <img
          class="theme-img"
          data-mode="light"
          src={set.preview.light.src}
          width={set.preview.light.width / PREVIEW_SCALE}
          height={set.preview.light.height / PREVIEW_SCALE}
          alt={`Pratinjau ${set.name}`}
          loading="lazy"
          decoding="async"
        />
        {set.preview.dark && (
          <img
            class="theme-img"
            data-mode="dark"
            src={set.preview.dark.src}
            width={set.preview.dark.width / PREVIEW_SCALE}
            height={set.preview.dark.height / PREVIEW_SCALE}
            alt={`Pratinjau ${set.name}, mode Dark`}
            loading="lazy"
            decoding="async"
          />
        )}
      </div>
      <figcaption class="preview-note">Gambar dari Figma dengan brand UIC, mengikuti mode Light atau Dark yang dipilih.</figcaption>
    </figure>
  )
}

{usage && body && <div class="prose description" set:html={renderMarkdown(body, { labels: true, labelLevel: level, labelIdPrefix: idPrefix })} />}

{
  design &&
    shots.map((shot) => (
      <div class="spec">
        <Heading class="spec-title" id={id(shot.id)}>
          {shot.title}
        </Heading>
        <p class="spec-note">Setiap pilihan <strong>{shot.axis}</strong>{shot.note ? `, ${shot.note}.` : '.'}</p>
        <figure class="shots-figure">
          <div class="shots" style={`--shot-w: ${shot.width}px`}>
            {shot.items.map((item) => (
              <div class="shot">
                <p class="shot-label">{item.value}{item.value === shot.default && <span class="shot-default"> · bawaan</span>}</p>
                <img
                  class="theme-img"
                  data-mode="light"
                  src={item.light.src}
                  width={item.light.width / PREVIEW_SCALE}
                  height={item.light.height / PREVIEW_SCALE}
                  alt={`${set.name}, ${shot.axis} ${item.value}`}
                  loading="lazy"
                  decoding="async"
                />
                <img
                  class="theme-img"
                  data-mode="dark"
                  src={item.dark.src}
                  width={item.dark.width / PREVIEW_SCALE}
                  height={item.dark.height / PREVIEW_SCALE}
                  alt={`${set.name}, ${shot.axis} ${item.value}, mode Dark`}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
          <figcaption class="preview-note">
            {shot.others.length > 0 && `Properti lain: ${shot.others.join(', ')}. `}Gambar dari Figma dengan brand UIC, mengikuti mode Light atau Dark yang dipilih.
          </figcaption>
        </figure>
      </div>
    ))
}

{
  design && (
    <div class="spec">
      <Heading class="spec-title" id={id('varian')}>Varian</Heading>
      {
        axes.length ? (
          <>
            <p class="spec-note">{set.variants} varian dari kombinasi properti berikut.</p>
            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr>
                    <th>Properti</th>
                    <th>Pilihan</th>
                  </tr>
                </thead>
                <tbody>
                  {axes.map(([axis, options]) => (
                    <tr>
                      <td class="nowrap">
                        <strong>{axis}</strong>
                      </td>
                      <td>
                        <span class="options">
                          {options.map((option) => (
                            <span class="tag">{option}</span>
                          ))}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        ) : (
          <p class="spec-note">Komponen tunggal, tanpa varian.</p>
        )
      }
    </div>
  )
}

{
  design && set.props.length > 0 && (
    <div class="spec">
      <Heading class="spec-title" id={id('properti')}>Properti</Heading>
      <p class="spec-note">Diatur di panel kanan Figma setelah komponen dipilih.</p>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Properti</th>
              <th>Jenis</th>
              <th>Bawaan</th>
            </tr>
          </thead>
          <tbody>
            {set.props.map(([name, type, value]) => (
              <tr>
                <td>
                  <strong>{name}</strong>
                </td>
                <td class="nowrap muted">{PROPERTY_TYPES[type] ?? type}</td>
                <td>
                  {type === 'BOOLEAN' && <span class:list={['tag', value ? 'tag-success' : '']}>{value ? 'Tampil' : 'Sembunyi'}</span>}
                  {type === 'TEXT' && <span>“{value}”</span>}
                  {type === 'INSTANCE_SWAP' && (
                    <span class="swap">
                      <code class="inline-code">{swapDefault(value).name}</code>
                      {swapDefault(value).detail && <span class="muted"> {swapDefault(value).detail}</span>}
                    </span>
                  )}
                  {!['BOOLEAN', 'TEXT', 'INSTANCE_SWAP'].includes(type) && <span>{String(value)}</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )
}

<style>
  .preview { margin: 0 0 var(--cargo-space-24); }
  .spec-title + .preview { margin-top: var(--cargo-space-16); }
  .preview-stage {
    display: grid;
    place-items: center;
    padding: var(--cargo-space-24);
    border: var(--cargo-border-width-1) solid var(--cargo-color-border-subtle);
    border-radius: var(--cargo-radius-12);
    background: var(--cargo-color-bg-secondary);
    overflow-x: auto;
  }
  /* In Dark the stage takes the page colour, so floating panels (bg/elevated) stand out as they do in products. */
  :global([data-theme='dark']) .preview-stage { background: var(--cargo-color-bg-default); }
  .preview-stage img { max-width: 100%; height: auto; }
  .preview-note { margin-top: var(--cargo-space-8); color: var(--cargo-color-text-tertiary); font-size: 12px; line-height: 16px; }
  .description :global(.md-label) { margin-top: var(--cargo-space-24); }
  .description :global(.md-label:first-child) { margin-top: 0; }
  .spec { margin-top: var(--cargo-space-32); }
  :global(.tabs) + .spec { margin-top: 0; }
  .spec-title {
    font-size: var(--cargo-heading-3-font-size);
    line-height: var(--cargo-heading-3-line-height);
    letter-spacing: var(--cargo-heading-3-letter-spacing);
  }
  h2.spec-title {
    font-size: var(--cargo-heading-2-font-size);
    line-height: var(--cargo-heading-2-line-height);
    letter-spacing: var(--cargo-heading-2-letter-spacing);
  }
  .spec-note { margin: var(--cargo-space-4) 0 var(--cargo-space-12); color: var(--cargo-color-text-secondary); font-size: 14px; }
  .options { display: flex; flex-wrap: wrap; gap: var(--cargo-space-4); }
  .shots-figure { margin: 0; }
  /* The page background, not bg/secondary: hover states are tints of it, and products show them on it. */
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, calc(var(--shot-w) * 0.85)), 1fr));
    gap: var(--cargo-space-24) var(--cargo-space-16);
    padding: var(--cargo-space-24);
    border: var(--cargo-border-width-1) solid var(--cargo-color-border-subtle);
    border-radius: var(--cargo-radius-12);
    background: var(--cargo-color-bg-default);
  }
  /* Labels on one line at the top, images centred in the space below, as in Soul. */
  .shot { display: grid; grid-template-rows: auto 1fr; justify-items: center; align-items: center; gap: var(--cargo-space-8); min-width: 0; }
  .shot img { max-width: 100%; height: auto; }
  .shot-label {
    margin: 0;
    color: var(--cargo-color-text-secondary);
    font-family: var(--site-font-mono);
    font-size: 12px;
    line-height: 16px;
    text-align: center;
  }
  .shot-default { color: var(--cargo-color-text-tertiary); }
  .swap { white-space: nowrap; }
</style>
