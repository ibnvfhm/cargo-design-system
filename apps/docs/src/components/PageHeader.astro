---
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}

const { title, eyebrow, lead } = Astro.props;
---

<header class="page-header">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="page-title">{title}</h1>
  {lead && <p class="lead">{lead}</p>}
  {Astro.slots.has('default') && <div class="page-actions"><slot /></div>}
</header>
