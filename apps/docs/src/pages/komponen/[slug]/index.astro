---
import ComponentSet from '../../../components/ComponentSet.astro';
import Icon from '../../../components/Icon.astro';
import ComponentPage from '../../../layouts/ComponentPage.astro';
import { components, figmaUrl } from '../../../lib/components.mjs';

export function getStaticPaths() {
  return components.map((component, index) => ({ params: { slug: component.slug }, props: { index } }));
}

const { index } = Astro.props;
const component = components[index];
const mainSets = component.sets.filter((set) => !set.helper);
const several = mainSets.length > 1;
---

<ComponentPage index={index} tab="penggunaan">
  <dl class="status">
    <div>
      <dt>Desain di Figma</dt>
      <dd>
        {
          component.ready ? (
            <span class="tag tag-success">
              <Icon name="CheckCircle" variant="fill" size={14} />
              Siap dipakai
            </span>
          ) : (
            <span class="tag tag-warning">Dalam pengerjaan</span>
          )
        }
      </dd>
    </div>
    <div>
      <dt>Komponen kode</dt>
      <dd><span class="tag tag-warning">Belum tersedia</span></dd>
    </div>
  </dl>

  {
    several && (
      <nav class="set-nav" aria-label="Komponen di halaman ini">
        <span class="muted">Di halaman ini:</span>
        {mainSets.map((set) => (
          <a href={`#${set.slug}`}>{set.name}</a>
        ))}
      </nav>
    )
  }

  {
    mainSets.map((set) =>
      several ? (
        <section class="set">
          <div class="set-head">
            <h2 class="section-title" id={set.slug}>
              {set.name}
            </h2>
            <p class="section-intro">{set.summary}</p>
            <a class="set-link" href={figmaUrl(set.id)} target="_blank" rel="noopener">
              Buka {set.name} di Figma
              <Icon name="ArrowUpRight" size={14} />
            </a>
          </div>
          <ComponentSet set={set} part="usage" level={3} idPrefix={`${set.slug}-`} />
        </section>
      ) : (
        <ComponentSet set={set} part="usage" level={2} idPrefix="" previewHeading />
      ),
    )
  }
</ComponentPage>

<style>
  /* Like the component checklist at the top of Soul's usage tab. */
  .status {
    margin: 0 0 var(--cargo-space-40);
    padding: 0 var(--cargo-space-20);
    border-radius: var(--cargo-radius-12);
    background: var(--cargo-color-bg-secondary);
  }
  .status div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--cargo-space-16);
    padding: var(--cargo-space-12) 0;
  }
  .status div + div { border-top: var(--cargo-border-width-1) solid var(--cargo-color-border-subtle); }
  .status dt { font-size: 14px; font-weight: var(--cargo-font-weight-bold); }
  .status dd { margin: 0; }
</style>
