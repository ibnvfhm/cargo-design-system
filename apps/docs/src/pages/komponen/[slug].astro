---
import ComponentSet from '../../components/ComponentSet.astro';
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import { components, figmaUrl } from '../../lib/components.mjs';
import { url } from '../../lib/site.mjs';

export function getStaticPaths() {
  return components.map((component, index) => ({ params: { slug: component.slug }, props: { index } }));
}

const { index } = Astro.props;
const component = components[index];
const previous = components[index - 1];
const next = components[index + 1];
const mainSets = component.sets.filter((set) => !set.helper);
const helpers = component.sets.filter((set) => set.helper);
const several = mainSets.length > 1;
---

<Base title={component.page} width="wide" description={`${component.page}: ${component.summary}`}>
  <header class="page-header">
    <p class="eyebrow">Komponen · {component.category.name}</p>
    <h1 class="page-title">{component.page}</h1>
    <p class="lead">{component.summary}</p>
    <div class="page-actions">
      <a class="btn btn-primary btn-sm" href={figmaUrl(component.pageId)} target="_blank" rel="noopener">
        Buka di Figma<Icon name="ArrowUpRight" size={16} />
      </a>
      {component.ready && <span class="tag tag-success"><Icon name="CheckCircle" variant="fill" size={14} />Siap dipakai</span>}
      <span class="tag">{component.variants} varian</span>
      {several && <span class="tag">{mainSets.length} komponen</span>}
    </div>
  </header>

  {
    several && (
      <nav class="set-nav" aria-label="Komponen di halaman ini">
        <span class="muted">Di halaman ini:</span>
        {mainSets.map((set) => (
          <a href={`#${set.slug}`}>{set.name}</a>
        ))}
        {helpers.length > 0 && <a href="#bagian-penyusun">Bagian penyusun</a>}
      </nav>
    )
  }

  {
    mainSets.map((set) => (
      <section class="set">
        {several && (
          <div class="set-head">
            <h2 class="section-title" id={set.slug}>
              {set.name}
            </h2>
            <p class="section-intro">{set.summary}</p>
            <a class="set-link" href={figmaUrl(set.id)} target="_blank" rel="noopener">
              Buka {set.name} di Figma
              <Icon name="ArrowUpRight" size={14} />
            </a>
          </div>
        )}
        <ComponentSet set={set} level={several ? 3 : 2} />
      </section>
    ))
  }

  {
    helpers.length > 0 && (
      <section class="set">
        <div class="set-head">
          <h2 class="section-title" id="bagian-penyusun">
            Bagian penyusun
          </h2>
          <p class="section-intro">
            Komponen ini dipakai di dalam {component.page}. Namanya diawali titik, jadi tidak ikut terbit di library dan tidak perlu diambil sendiri.
          </p>
        </div>
        {helpers.map((set) => (
          <details class="helper">
            <summary>
              <span class="helper-name">{set.name}</span>
              <span class="helper-summary">{set.summary}</span>
            </summary>
            <div class="helper-body">
              <ComponentSet set={set} level={4} />
            </div>
          </details>
        ))}
      </section>
    )
  }

  <nav class="pager" aria-label="Komponen lain">
    {
      previous ? (
        <a class="pager-link" href={url(`/komponen/${previous.slug}/`)}>
          <span class="pager-label">
            <Icon name="ArrowLeft" size={16} />
            Sebelumnya
          </span>
          <span class="pager-name">{previous.page}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a class="pager-link pager-next" href={url(`/komponen/${next.slug}/`)}>
          <span class="pager-label">
            Berikutnya
            <Icon name="ArrowRight" size={16} />
          </span>
          <span class="pager-name">{next.page}</span>
        </a>
      )
    }
  </nav>
</Base>

<style>
  .page-actions .tag { min-height: 28px; padding: var(--cargo-space-4) var(--cargo-space-12); }
  .set-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--cargo-space-6) var(--cargo-space-12);
    margin-bottom: var(--cargo-space-32);
    padding: var(--cargo-space-12) var(--cargo-space-16);
    border: var(--cargo-border-width-1) solid var(--cargo-color-border-subtle);
    border-radius: var(--cargo-radius-12);
    font-size: 14px;
  }
  .set + .set { margin-top: var(--cargo-space-64); }
  .set-head { margin-bottom: var(--cargo-space-24); }
  .set-link { display: inline-flex; align-items: center; gap: 2px; margin-top: var(--cargo-space-8); font-size: 13px; }
  .helper {
    border: var(--cargo-border-width-1) solid var(--cargo-color-border-subtle);
    border-radius: var(--cargo-radius-12);
  }
  .helper + .helper { margin-top: var(--cargo-space-12); }
  .helper summary {
    display: grid;
    gap: 2px;
    padding: var(--cargo-space-16) var(--cargo-space-20);
    cursor: pointer;
    list-style: none;
  }
  .helper summary::-webkit-details-marker { display: none; }
  .helper summary::after { content: ''; }
  .helper-name { font-weight: var(--cargo-font-weight-bold); }
  .helper-summary { color: var(--cargo-color-text-secondary); font-size: 14px; line-height: 20px; }
  .helper-body { padding: 0 var(--cargo-space-20) var(--cargo-space-20); }
  .helper[open] summary { border-bottom: var(--cargo-border-width-1) solid var(--cargo-color-border-subtle); margin-bottom: var(--cargo-space-20); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: var(--cargo-space-16); margin-top: var(--cargo-space-64); }
  .pager-link {
    display: grid;
    gap: var(--cargo-space-4);
    padding: var(--cargo-space-16) var(--cargo-space-20);
    border: var(--cargo-border-width-1) solid var(--cargo-color-border-subtle);
    border-radius: var(--cargo-radius-12);
    color: var(--cargo-color-text-default);
    text-decoration: none;
  }
  .pager-link:hover { border-color: var(--cargo-color-border-brand); color: var(--cargo-color-text-default); }
  .pager-next { text-align: right; justify-items: end; }
  .pager-label { display: inline-flex; align-items: center; gap: var(--cargo-space-4); color: var(--cargo-color-text-tertiary); font-size: 13px; }
  .pager-name { font-weight: var(--cargo-font-weight-bold); color: var(--cargo-color-text-brand); }
</style>
