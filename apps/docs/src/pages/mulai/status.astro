---
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import Base from '../../layouts/Base.astro';
import tokensPackage from '@tokens/package.json';
import { components, figmaUrl } from '../../lib/components.mjs';
import { url } from '../../lib/site.mjs';

const steps = [
  { step: 1, name: 'Primitive colors', detail: 'Semua warna mentah, di Figma dan di kode.', status: 'done' },
  { step: 2, name: 'Semantic colors', detail: 'Tugas tiap warna: latar, teks, ikon, garis, dan status.', status: 'done' },
  { step: 3, name: 'Tema brand dan mode gelap', detail: 'Lima brand, mode Light dan Dark.', status: 'done' },
  { step: 4, name: 'Token non-warna', detail: 'Spacing, radius, tebal garis, tipografi, dan shadow.', status: 'done' },
  { step: 5, name: 'Token di komponen Figma', detail: 'Semua komponen dan ikon memakai token, dan setiap halaman komponen sudah direview.', status: 'done' },
  { step: 6, name: 'Paket developer dan situs dokumentasi', detail: `Token versi ${tokensPackage.version} dirilis, dan situs ini online serta diperbarui otomatis setiap ada perubahan di repo. Paket belum diterbitkan di npm.`, status: 'done' },
  { step: 7, name: 'Menerbitkan library Figma', detail: `Variable, style, dan komponen di Figma sudah sama persis dengan token ${tokensPackage.version}. Tinggal diterbitkan dari Figma.`, status: 'progress' },
];

const LABEL = { done: 'Selesai', progress: 'Berjalan' };
const ready = components.filter((component) => component.ready).length;
---

<Base title="Status" width="wide">
  <PageHeader eyebrow="Pembaruan" title="Status" lead="Perkembangan Cargo Design System, dari token sampai situs dokumentasi, dan status setiap komponen." />

  <div class="prose"><h2>Tahapan</h2></div>
  <div class="table-wrap block">
    <table class="table">
      <thead>
        <tr><th>Langkah</th><th>Isi</th><th>Status</th></tr>
      </thead>
      <tbody>
        {
          steps.map((item) => (
            <tr>
              <td class="nowrap">{item.step}</td>
              <td>
                <strong>{item.name}</strong>
                <div class="muted">{item.detail}</div>
              </td>
              <td class="nowrap">
                <span class:list={['tag', item.status === 'done' ? 'tag-success' : 'tag-info']}>{LABEL[item.status]}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="prose">
    <h2>Komponen</h2>
    <p>{ready} dari {components.length} halaman komponen sudah direview dan diberi tanda ✅ di Figma.</p>
  </div>
  <div class="table-wrap block">
    <table class="table">
      <thead>
        <tr><th>Komponen</th><th>Kategori</th><th>Set</th><th>Varian</th><th>Status</th><th><span class="sr-only">Figma</span></th></tr>
      </thead>
      <tbody>
        {
          components.map((component) => (
            <tr>
              <td><a href={url(`/komponen/${component.slug}/`)}>{component.page}</a></td>
              <td class="muted">{component.category.name}</td>
              <td>{component.sets.length}</td>
              <td>{component.variants}</td>
              <td class="nowrap">
                <span class:list={['tag', component.ready ? 'tag-success' : 'tag-warning']}>{component.ready ? 'Siap dipakai' : 'Direview'}</span>
              </td>
              <td class="nowrap">
                <a class="figma-link" href={figmaUrl(component.pageId)} target="_blank" rel="noopener">
                  Figma<Icon name="ArrowUpRight" size={14} />
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="prose">
    <h2>Berikutnya</h2>
    <ul>
      <li>Terbitkan library Figma supaya komponen, variable, dan style bisa dipakai di file lain.</li>
      <li>Terbitkan paket token di npm supaya developer cukup menjalankan <code>npm install</code>, tanpa menyalin file dari repo.</li>
      <li>Komponen kode (React dan Storybook) dengan nama dan properti yang sama dengan Figma.</li>
    </ul>
  </div>
</Base>

<style>
  .block { margin-top: var(--cargo-space-16); }
  .figma-link { display: inline-flex; align-items: center; gap: 2px; font-size: 13px; }
</style>
